{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "clickhouse-ruler values",
  "description": "Validated at render time, so a bad install fails before a pod boots.",
  "type": "object",
  "required": [
    "image",
    "replicaCount",
    "ruler",
    "rules"
  ],
  "properties": {
    "image": {
      "type": "object",
      "required": [
        "repository",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "nameOverride": {
      "type": "string",
      "maxLength": 63
    },
    "fullnameOverride": {
      "type": "string",
      "maxLength": 63
    },
    "alertmanagerURLs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^https?://.+"
      },
      "description": "Alertmanager cluster to deliver to, one entry per member. Every alert is posted to every member. Required when sources is set, and left empty when sourcesSecret.name supplies the whole file. The ruler refuses to start on an entry that is not an http:// or https:// URL with a host, on the same address twice, or on one carrying a credential."
    },
    "alertmanagerAuth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "secretName": {
          "type": "string",
          "description": "Secret holding the credential, mounted read-only. The secret value never appears in values."
        },
        "basicAuth": {
          "type": "object",
          "additionalProperties": false,
          "required": ["username"],
          "properties": {
            "username": {"type": "string", "minLength": 1},
            "key": {"type": "string", "minLength": 1, "description": "Key in the Secret holding the password. Defaults to password."}
          }
        },
        "authorization": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {"type": "string", "minLength": 1, "description": "Authorization scheme. Defaults to Bearer."},
            "key": {"type": "string", "minLength": 1, "description": "Key in the Secret holding the credential. Defaults to credentials."}
          }
        }
      },
      "description": "Credential the ruler authenticates to Alertmanager with. Empty for an Alertmanager that is not behind auth. basicAuth and authorization write the same header, so set one."
    },
    "ruler": {
      "type": "object",
      "required": [
        "port",
        "logLevel",
        "logFormat",
        "shutdownTimeoutSeconds"
      ],
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "logLevel": {
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ]
        },
        "logFormat": {
          "enum": [
            "text",
            "json"
          ]
        },
        "shutdownTimeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "rules": {
      "type": "object",
      "required": [
        "delivery"
      ],
      "properties": {
        "delivery": {
          "enum": [
            "git-sync",
            "configMap"
          ]
        },
        "subdirectory": {
          "type": "string"
        },
        "configMap": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            }
          }
        },
        "gitSync": {
          "type": "object",
          "properties": {
            "image": {
              "type": "object",
              "required": [
                "repository",
                "tag"
              ],
              "properties": {
                "repository": {
                  "type": "string",
                  "minLength": 1
                },
                "tag": {
                  "type": "string",
                  "minLength": 1
                },
                "pullPolicy": {
                  "enum": [
                    "Always",
                    "IfNotPresent",
                    "Never"
                  ]
                }
              }
            },
            "repo": {
              "type": "string"
            },
            "ref": {
              "type": "string",
              "minLength": 1
            },
            "period": {
              "type": "string",
              "pattern": "^[0-9]+(ms|s|m|h)$"
            },
            "depth": {
              "type": "integer",
              "minimum": 0
            },
            "credentialsSecret": {
              "type": "string"
            },
            "extraArgs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "resources": {
              "type": "object"
            },
            "securityContext": {
              "type": "object"
            }
          }
        }
      },
      "description": "How rule files reach the ruler. Which of gitSync.repo and configMap.name is required follows from delivery, and the template names the missing one."
    },
    "sources": {
      "type": "array",
      "description": "Templated into the operator's file. No entry may carry a password.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "address",
          "database",
          "username",
          "table",
          "timestamp_column"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "labels": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "address": {
            "type": "string",
            "minLength": 1
          },
          "database": {
            "type": "string",
            "minLength": 1
          },
          "username": {
            "type": "string",
            "minLength": 1
          },
          "passwordSecret": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "key": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "table": {
            "type": "string",
            "minLength": 1
          },
          "timestamp_column": {
            "type": "string",
            "minLength": 1
          },
          "evaluation_delay": {
            "type": "string",
            "pattern": "^[0-9]+(ms|s|m|h)$"
          },
          "max_rows": {
            "type": "integer",
            "minimum": 0
          },
          "max_execution_time": {
            "type": "string",
            "pattern": "^[0-9]+(ms|s|m|h)$"
          },
          "max_memory_usage": {
            "type": "integer",
            "minimum": 0
          },
          "max_concurrent_queries": {
            "type": "integer",
            "minimum": 0
          },
          "checks": {
            "type": "object"
          },
          "exempt": {
            "type": "object"
          }
        }
      }
    },
    "sourcesSecret": {
      "type": "object",
      "required": [
        "key"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "key": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "policy": {
      "type": "string"
    },
    "extraContainers": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "extraVolumes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "extraVolumeMounts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "service": {
      "type": "object",
      "required": [
        "type",
        "port"
      ],
      "properties": {
        "type": {
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "required": [
        "create"
      ],
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "interval": {
          "type": "string"
        },
        "scrapeTimeout": {
          "type": "string"
        },
        "labels": {
          "type": "object"
        },
        "annotations": {
          "type": "object"
        },
        "relabelings": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "metricRelabelings": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "maxUnavailable": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        }
      }
    },
    "priorityClassName": {
      "type": "string"
    },
    "resources": {
      "type": "object"
    },
    "readinessProbe": {
      "type": "object"
    },
    "livenessProbe": {
      "type": "object"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "podAnnotations": {
      "type": "object"
    },
    "podLabels": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "topologySpreadConstraints": {
      "type": "array"
    }
  }
}
