{
  "title": "clickhouse-ruler / operations",
  "uid": "clickhouse-ruler-operations",
  "description": "Is the ruler doing its job. For whoever operates it: missed iterations first, then failures, duration, staleness and delivery (spec 8.6).",
  "tags": [
    "clickhouse-ruler"
  ],
  "editable": true,
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "rule_group",
        "label": "Rule group",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(clickhouse_ruler_rule_group_iterations_total, rule_group)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "title": "Missed iterations",
      "description": "A group whose evaluation took longer than its interval. The single most important signal here, because alerts are then silently late (spec 8.2). Anything above zero for more than a few minutes wants either a cheaper query or a longer interval.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 40
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (rule_group) (rate(clickhouse_ruler_rule_group_iterations_missed_total{rule_group=~\"$rule_group\"}[$__rate_interval]))",
          "legendFormat": "{{rule_group}}"
        }
      ]
    },
    {
      "title": "Evaluation failures",
      "description": "Evaluations that did not happen, per rule. A broken annotation is not one of these and has its own panel on the alert rules dashboard.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (rule_group, rule) (rate(clickhouse_ruler_rule_evaluation_failures_total{rule_group=~\"$rule_group\"}[$__rate_interval]))",
          "legendFormat": "{{rule_group}} / {{rule}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (rule_group) (rate(clickhouse_ruler_rule_evaluations_total{rule_group=~\"$rule_group\"}[$__rate_interval]))",
          "legendFormat": "{{rule_group}} evaluated"
        }
      ]
    },
    {
      "title": "Evaluation duration",
      "description": "How long a group takes. Read against the interval that group is configured with, which lives in the rule file rather than in a metric: a duration approaching the interval is the missed iterations above, about to happen.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "clickhouse_ruler_rule_group_last_duration_seconds{rule_group=~\"$rule_group\"}",
          "legendFormat": "{{rule_group}} last"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.99, sum by (rule_group, le) (rate(clickhouse_ruler_rule_evaluation_duration_seconds_bucket{rule_group=~\"$rule_group\"}[$__rate_interval])))",
          "legendFormat": "{{rule_group}} p99"
        }
      ]
    },
    {
      "title": "Time since last evaluation",
      "description": "How long ago each group last finished. A group that has stopped evaluating climbs here whether or not anything failed, which is the case no failure counter reports.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 17
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "time() - max by (rule_group) (clickhouse_ruler_rule_group_last_evaluation_timestamp_seconds{rule_group=~\"$rule_group\"})",
          "legendFormat": "{{rule_group}}"
        }
      ]
    },
    {
      "title": "Alerts sent and send failures",
      "description": "Delivery to Alertmanager. A failure counts the batch once however many alerts it held, because it delivered none of them.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 17
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (alertmanager) (rate(clickhouse_ruler_alerts_sent_total[$__rate_interval]))",
          "legendFormat": "{{alertmanager}} sent"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (alertmanager) (rate(clickhouse_ruler_alerts_send_failures_total[$__rate_interval]))",
          "legendFormat": "{{alertmanager}} failed"
        }
      ]
    },
    {
      "title": "Notification latency",
      "description": "Time spent posting a batch to Alertmanager. Latency climbing alongside send failures is Alertmanager, not the ruler.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 25
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(clickhouse_ruler_notification_latency_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p99"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(clickhouse_ruler_notification_latency_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50"
        }
      ]
    },
    {
      "title": "Query cost",
      "description": "What rules are reading, from the driver's own callbacks rather than from system.query_log. The rate is the number that matters: the same query is cheap hourly and ruinous every fifteen seconds. An empty team is a rule whose author set no team label.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 33
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (team) (rate(clickhouse_ruler_query_read_bytes_total[$__rate_interval]))",
          "legendFormat": "{{team}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "topk(5, sum by (rule) (rate(clickhouse_ruler_query_read_bytes_total[$__rate_interval])))",
          "legendFormat": "{{rule}}"
        }
      ]
    },
    {
      "title": "Query memory and duration",
      "description": "Peak memory one evaluation's query reached on the server, against the max_memory_usage cap the source sends, and how long the ruler waited for it. Duration climbing here is what becomes a missed iteration above.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 33
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.99, sum by (rule, le) (rate(clickhouse_ruler_query_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{rule}} p99 duration"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(clickhouse_ruler_query_memory_usage_bytes_bucket[$__rate_interval])))",
          "legendFormat": "p99 memory (bytes)"
        }
      ]
    },
    {
      "title": "Source queue wait",
      "description": "How long a query waited for a slot against its source's max_concurrent_queries limit. Only sources that set one appear. A small steady wait is the limit doing its job; a wait approaching the group interval is a limit set too low, or a cluster gone slow with the limit containing it.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 41
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.99, sum by (source, le) (rate(clickhouse_ruler_query_queue_wait_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{source}} p99 queue wait"
        }
      ]
    }
  ]
}
